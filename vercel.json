{
  "rewrites": [
    {
      "source": "/gerai/:slug/qr-drop",
      "destination": "/gerai/qr-drop/index.html"
    },
    {
      "source": "/gerai",
      "destination": "/gerai/index.html"
    },
    {
      "source": "/gerai/(.*)",
      "destination": "/gerai/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/gerai/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/gerai/qr-drop/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
